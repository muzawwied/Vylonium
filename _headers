# Donasi: jangan masuk indeks mesin pencari
/donasi/*
  X-Robots-Tag: noindex, nofollow

/donasi
  X-Robots-Tag: noindex, nofollow

# Aset gambar: nama file diberi versi (?v=N) saat berubah, jadi aman di-cache lama
/img/*
  Cache-Control: public, max-age=604800

# Ikon & manifest jarang berubah
/favicon.ico
  Cache-Control: public, max-age=604800

/site.webmanifest
  Cache-Control: public, max-age=3600
